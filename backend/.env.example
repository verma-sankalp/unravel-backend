# Copy this file to ".env" in the same folder and fill in what you have.
# Nothing here is required to run the server — features degrade gracefully
# if a key is missing.

# Port the API listens on
PORT=8787

# Comma-separated list of origins allowed to call this API from a browser.
# For local development with the frontend opened via a local server:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Optional: Google Safe Browsing v4 API key.
# Get one free at https://console.cloud.google.com/ → enable "Safe Browsing API" → Credentials.
# Without this, the safe-browsing check is skipped (not faked).
SAFE_BROWSING_API_KEY=

# Timeout (ms) for each outbound check (RDAP, redirect follow, URLhaus, Safe Browsing)
CHECK_TIMEOUT_MS=6000
